{
  "name": "@gymmymac/bob-widget",
  "version": "3.1.12",
  "description": "Bob - AI-powered automotive parts assistant widget with multi-tenant support, RAF animations, swipeable interactions, and GA4 analytics",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "bob-widget": "bin/bob-widget.mjs"
  },
  "files": [
    "dist",
    "bin",
    "install",
    "BOB-DOCUMENTATION.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GymmyMac/bob-lovable.git"
  },
  "keywords": [
    "carfix",
    "bob",
    "automotive",
    "parts",
    "ai",
    "chatbot",
    "widget"
  ],
  "license": "MIT"
}
